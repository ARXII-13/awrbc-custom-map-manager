# Copy to .env and fill in. Nothing here has a default on purpose - a
# hardcoded fallback is the kind of thing that survives into production.

# A Discord application: https://discord.com/developers/applications
# Add PUBLIC_URL/auth/callback as a redirect URI.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# A *bot account's* token with push access to the library repo. Not yours:
# commits made with your token say you wrote the map.
GITHUB_TOKEN=
LIBRARY_REPO=ARXII-13/awrbc-custom-map-library

# Any long random string: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Where this server is reachable, and where to send people afterwards.
PUBLIC_URL=http://127.0.0.1:5000
EDITOR_URL=http://127.0.0.1:8731/

# How to run the Python tool. Default 'awrbc'; may carry arguments, which is
# useful in a container where the console script is not on PATH.
# AWRBC_COMMAND=python -m awrbc

# Only for local development over plain HTTP. Never set this in production -
# it drops the Secure flag from the session cookie.
# INSECURE_COOKIES=1
