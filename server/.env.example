# Copy to .env and fill in. Nothing here has a default on purpose - a
# hardcoded fallback is the kind of thing that survives into production.

# Take submissions with nobody signed in. The two Discord variables below are
# then not needed at all, and the author published is whatever the contributor
# typed in the editor - which is most of what sign-in was buying, since a name
# is self-declared either way.
#
# What it gives up, so that it is a decision rather than a default: nothing
# stands behind that name, a revision of somebody else's map is checked by
# comparing one claim against another, and rate limiting falls back to the
# client address. Merging is still a person reading a pull request, so
# reachable from the internet the cost is noise, not a corrupted archive.
# OPEN_SUBMISSIONS=1

# A Discord *application*, not a Discord server: a form at
# https://discord.com/developers/applications that issues OAuth credentials.
# This only ever asks it who you are (scope `identify`). Add
# PUBLIC_URL/auth/callback as a redirect URI, matching exactly - a mismatch is
# the most common way the sign-in flow fails.
# Leave both blank if OPEN_SUBMISSIONS is set.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# A *bot account's* token with push access to the library repo. Not yours:
# commits made with your token say you wrote the map.
GITHUB_TOKEN=
LIBRARY_REPO=ARXII-13/awrbc-custom-map-library

# Any long random string: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Origins allowed to call this server. EDITOR_URL is included automatically.
# Getting this wrong looks like the editor never signing in - see the README.
# ALLOWED_ORIGINS=https://maps.example

# Where this server is reachable, and where to send people afterwards.
PUBLIC_URL=http://127.0.0.1:5000
EDITOR_URL=http://127.0.0.1:8731/

# How to run the Python tool. Default 'awrbc'; may carry arguments, which is
# useful in a container where the console script is not on PATH.
# AWRBC_COMMAND=python -m awrbc

# Only for local development over plain HTTP. Never set this in production -
# it drops the Secure flag from the session cookie.
# INSECURE_COOKIES=1
